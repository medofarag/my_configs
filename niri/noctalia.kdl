layout {

    focus-ring {
        active-color   "#e4ba67"
        inactive-color "#292214"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e4ba67"
        inactive-color "#292214"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e4ba67"
        inactive-color "#855f14"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e4ba6780"
    }
}

recent-windows {
    highlight {
        active-color "#e4ba67"
        urgent-color "#fd4663"
    }
}
