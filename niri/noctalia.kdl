layout {

    focus-ring {
        active-color   "#67a6e4"
        inactive-color "#1d1f21"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67a6e4"
        inactive-color "#1d1f21"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#67a6e4"
        inactive-color "#144d85"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67a6e480"
    }
}

recent-windows {
    highlight {
        active-color "#67a6e4"
        urgent-color "#fd4663"
    }
}
