{
  "layer": "top",
  "spacing": 2,
  "height": 0,
  "margin-bottom": 0,
  "margin-top": 2,
  "position": "top",
  "margin-right": 2,
  "margin-left": 2,
  "modules-left": [
    "custom/powermenu",
    "sway/workspaces",
    "sway/mode",
    "custom/recorder",
    "custom/qrcode",
    "custom/colorpick",
    "tray"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/prayer",
    "cpu",
    "memory",
    "network",
    "sway/language",
    "pulseaudio",
    "custom/weather",
    "clock"
  ],
  "custom/prayer": {
    "exec": "~/.config/waybar/scripts/prayer_times",
    "return-type": "json",
    "interval": 60,
    "format": "{}",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/prayer_times rebuild",
    "on-click-right": "~/.config/waybar/scripts/prayer_times fetch_missing",
    "on-scroll-up": "~/.config/waybar/scripts/prayer_times up",
    "on-scroll-down": "~/.config/waybar/scripts/prayer_times down",
    "on-click-middle": "~/.config/waybar/scripts/prayer_times reset",
    "signal": 9
  },
  "custom/powermenu": {
    "format": "⏻",
    "on-click": "bash ~/.config/waybar/scripts/powermenu.sh"
  },
  "custom/recorder": {
    "format": "🎥",
    "on-click": "blue-recorder"
  },
  "custom/qrcode": {
    "format": "🔳",
    "on-click": "bash ~/.config/waybar/scripts/qrcode.sh"
  },
  "custom/colorpick":{
    "format": "🎨",
    "on-click": "bash ~/.config/waybar/scripts/picker.sh"
  },
  "custom/weather": {
    "exec": "wttrbar",
    "interval": 3600, // Update every hour (seconds)
    "return-type": "json",
    "format": "{}", // wttrbar outputs the temperature as the main text
    "tooltip": true
  },
  "sway/language": {
    "format": "{}",
    "tooltip-format": "{}",
    "format-en": "EN",
    "format-ara": "AR"
  },
  "tray": {
    "spacing": 10,
    "tooltip": false
  },
  "clock": {
    "format": "󰥔 {:%H:%M 󰃭 %Y/%m/%d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "gsimplecal",
    "calendar": {
      "format": {
        "months": "<span color='#00b7eb'><b>{}</b></span>",
        "today": "<span color='#00b7eb'><b>{}</b></span>"
      }
    }
  },
  "cpu": {
    "format": "CPU:{usage}%",
    "interval": 2,
    "on-click": "sakura -x btop"
  },
  "memory": {
    "format": "RAM:{percentage}%",
    "interval": 2,
    "on-click": "sakura -x btop"
  },
  "temperature": {
    "format": "Temp:{temperatureC}°C",
    "critical-threshold": 80,
    "interval": 2,
    "on-click": "sakura -x btop"
  },
  "network": {
    "format-wifi": "{icon}   {bandwidthDownBytes}  {bandwidthUpBytes}",
    "format-ethernet": "󰈀  {bandwidthDownBytes}  {bandwidthUpBytes}",
    "tooltip-format-wifi": "SSID: {essid}\nIP: {ipaddr}",
    "tooltip-format-ethernet": "IF: {ifname}\nIP: {ipaddr}",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "interval": 1
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "headphone": "󰋋",
      "headset": "󰋎",
      "bluetooth": "󰂰"
    },
    "on-click": "pavucontrol",
    "scroll-step": 5
  }
}
